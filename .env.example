# Copy this file to .env (same folder) and fill in real values.
# .env is already covered by .gitignore and .dockerignore - it will never
# be committed or baked into the Docker image. docker-compose.yml reads it
# via the commented-out `env_file` line - uncomment that once the app is
# updated to query the MySQL view directly instead of using file uploads.
#
# These point at the read-only MySQL user scoped to SELECT on the
# NetSuite/TIMS combined sales-history view (create that user in
# phpMyAdmin - never put an admin account's credentials here).

DB_HOST=192.168.1.10 # Actual IP address of the MySQL server (not localhost)
DB_PORT=3306 # Default MySQL port
DB_USER=streamlit_readonly # Read only DB User for the Sales History
DB_PASSWORD=change-this-password # Read only DB User Password
DB_NAME=steelfort_intranet # Database name (schema) where the view is located
DB_VIEW=netsuite_tims_sales_history # Name of the view that combines NetSuite and TIMS sales history data
