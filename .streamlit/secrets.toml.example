# Copy this file to secrets.toml (same folder) and set a real password.
# secrets.toml is gitignored - it will never be committed, so it's safe to
# put the real password in it locally.
#
# On Streamlit Community Cloud, you don't need this file at all - instead,
# paste the same line into the app's Advanced Settings > Secrets box when
# you deploy (or Settings > Secrets afterwards to change it).

APP_PASSWORD = "change-this-password"

# Needed for the AI Insights panel (summary/anomalies/chat). Get a key from
# https://console.anthropic.com - AI Insights is opt-in (button/chat press
# only) so this only costs money when actually used, not on every page load.
ANTHROPIC_API_KEY = "sk-ant-your-key-here"
