# Use lightweight Python image
FROM python:3.11-slim

# Keeps Python from writing .pyc files and buffers stdout less, so
# `docker logs` shows Streamlit's output immediately instead of batching it
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Set working directory inside container
WORKDIR /app

# Copy requirements first so Docker can cache dependency install
COPY requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the app after dependencies.
# .streamlit/secrets.toml never lands in here - it's excluded via
# .dockerignore and mounted in at runtime instead (see docker-compose.yml),
# so the real password/API key never get baked into an image layer.
COPY . .

# Run as a non-root user rather than the container's default root
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# Expose Streamlit port
EXPOSE 8501

# Lets `docker ps` / a future orchestrator see if the app has actually come
# up (not just that the process exists) - Streamlit exposes this endpoint
# by default
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" || exit 1

# Run the app. --server.headless=true stops Streamlit from trying to open a
# local browser or prompting for an email on first run, which matters
# inside a container with no display and no interactive terminal
CMD ["streamlit", "run", "app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true"]
